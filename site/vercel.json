{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/install.sh",
      "headers": [
        {
          "key": "content-type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "cache-control",
          "value": "public, max-age=300"
        }
      ]
    }
  ],
  "cleanUrls": true
}
