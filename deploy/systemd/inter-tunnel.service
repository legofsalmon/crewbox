[Unit]
Description=Cloudflare tunnel for Inter remote support access
Documentation=https://github.com/legofsalmon/inter/blob/main/deploy/RUNBOOK.md
# The tunnel is strictly optional: it may fail or be stopped at any time
# without affecting site chat, so it wants Inter but Inter never wants it.
After=network-online.target inter.service
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/cloudflared tunnel --config /etc/cloudflared/config.yml run
Restart=always
RestartSec=5
DynamicUser=yes

[Install]
WantedBy=multi-user.target
