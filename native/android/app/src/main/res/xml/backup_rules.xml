<?xml version="1.0" encoding="utf-8"?>
<!--
    What Android 11 and older back up: everything but the app's sign-ins and
    the alerts service's file. data_extraction_rules.xml, Android 12's and
    later's, says why.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="crewbox-sessions.xml" />
    <exclude domain="sharedpref" path="crewbox-alerts.xml" />
</full-backup-content>
