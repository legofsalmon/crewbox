<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!--
            specialUse, not dataSync: Android 14+ hard-caps dataSync
            foreground services at ~6 hours per day, then stops them — and a
            show day is 14+. specialUse has no timeout, and is exactly what
            it exists for: a legitimately long-running service in an app
            distributed outside the Play Store (this APK is sideloaded from
            the box, so there is no Play review in the loop — only the OS's
            own rules, which specialUse satisfies). The property below is the
            declared explanation the platform asks for.
        -->
        <service
            android:name=".AlertsService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Continuous crew-communications link to an offline event-site server: message alerts must arrive for the full length of a 14+ hour show day." />
        </service>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        Voice. The WebView asks for the microphone through getUserMedia and
        Capacitor's bridge answers by requesting RECORD_AUDIO from the OS —
        which fails immediately for a permission the app never declared, so
        every join in the APK was denied before anyone was asked. Voice
        simply did not exist in the native app; on the same box, in the
        phone's browser, it worked.

        MODIFY_AUDIO_SETTINGS goes with it: WebRTC switches the device into
        communication mode to get echo cancellation and the earpiece/speaker
        routing, which is the difference between a usable talkback and
        feedback under a PA.

        The microphone still stops when the app is backgrounded — Android 14
        requires a microphone-typed foreground service to hold it, which the
        alerts service is not. Someone on a call has the app open.
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!--
        Bluetooth headsets in voice. The web view chooses the call's audio
        device itself, and checks for Bluetooth permission once, when its
        audio first starts:

        - Android 11 and older check BLUETOOTH, and without it the web view
          never moves a call onto a Bluetooth headset. A normal permission:
          granted at install, no prompt, and gone from the list on newer
          Android.
        - Android 12 and later use a headset that is connected when voice
          starts either way. BLUETOOTH_CONNECT is what lets the web view
          notice one that connects during a call, or comes back after
          dropping out of range, and move the call onto it. A runtime
          permission, asked for once by VoicePlugin, and only of someone who
          joins voice with a Bluetooth headset connected.
    -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!--
        The buzz that goes with an alert, through @capacitor/haptics. The
        plugin's manifest asks for this as well and merges in; it is declared
        here too so everything the app asks a phone for is in one place and in
        the permission check. The web view's navigator.vibrate needed it just
        the same and was never given it, so alerts in the app never vibrated.
        A normal permission: granted at install, no prompt.
    -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!--
        The camera, for "Take a photo" in the attach menu. Capacitor's web
        view looks for a camera app before it opens one, and since Android 11
        an app only sees the other apps it has declared an interest in.
        Without this the look comes back empty on some phones (a Pixel 7a on
        Android 14 is on record, in Capacitor issue 7411) and the camera
        option opens the file picker instead. Not a permission: nothing on
        the install screen, and no CAMERA, which the camera app holds itself.
    -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>
</manifest>
