<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CAPACITOR_DEBUG</key>
	<string>$(CAPACITOR_DEBUG)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<!-- The name under the icon on the home screen. It said "Inter" — the
	     placeholder Capacitor's template ships — so an iPhone that installed
	     this showed a font name where the app's should be. -->
	<key>CFBundleDisplayName</key>
	<string>Crewbox</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- Only standard HTTPS/TLS is used (no proprietary/custom crypto), which
	     is exempt from U.S. export compliance — declaring this lets App Store
	     Connect skip the per-build encryption questionnaire. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSMicrophoneUsageDescription</key>
	<string>Crewbox uses the microphone for push-to-talk crew voice.</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- The crew server speaks plain HTTP on the local network only, and
		     `NSAllowsLocalNetworking` is exactly that exemption: private
		     addresses and .local names, nothing else.

		     `NSAllowsArbitraryLoads` was set beside it, which is not "local
		     only" — it turns App Transport Security off for every request the
		     app makes, to anywhere, and takes precedence over the comment
		     above it. It also draws a review question the app does not need
		     an answer to. If a plain-HTTP box on a public address ever becomes
		     a supported deployment, that is a decision to write down in
		     native/ios/APP-STORE-CHECKLIST.md, not a key to leave switched on. -->
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Crewbox connects to the crew server on the event Wi-Fi.</string>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
</dict>
</plist>
